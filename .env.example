# Existing env variables used by the backend
PORT=3000
MONGODB_URI=mongodb://localhost:27017/minor
JWT_SECRET=supersecret
JWT_REFRESH_SECRET=refreshsecret

# Biometric configuration
BIOMETRIC_CHALLENGE_TTL=60
USE_REDIS_CHALLENGE_STORE=false
# If using Redis for challenge store, set the URL below (e.g. redis://:password@host:6379)
REDIS_URL=redis://127.0.0.1:6379